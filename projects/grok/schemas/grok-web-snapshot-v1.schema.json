{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sapphire.local/schemas/grok-web-snapshot-v1.schema.json",
  "title": "Sapphire bounded-policy Grok web source snapshot receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "validator",
    "source",
    "content_manifest_sha256",
    "files",
    "summary"
  ],
  "properties": {
    "schema": {"const": "sapphire.grok-web-snapshot.receipt/v1"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "policy_profile", "policy_sha256"],
      "properties": {
        "name": {"const": "grok_web_snapshot"},
        "version": {"const": "14"},
        "policy_profile": {"const": "grok-export-v14"},
        "policy_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "requested_ref", "commit_oid", "tree_oid", "tree_prefix"],
      "properties": {
        "remote": {"const": "origin"},
        "requested_ref": {"const": "refs/remotes/origin/main"},
        "commit_oid": {"$ref": "#/$defs/gitOid"},
        "tree_oid": {"$ref": "#/$defs/gitOid"},
        "tree_prefix": {"const": "data/grok-web-exports"}
      }
    },
    "content_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "bytes"],
      "properties": {
        "files": {"type": "integer", "minimum": 1},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_relpath",
        "git_blob_oid",
        "sha256",
        "bytes",
        "media_type",
        "policy_profile"
      ],
      "properties": {
        "source_relpath": {"type": "string", "minLength": 1},
        "git_blob_oid": {"$ref": "#/$defs/gitOid"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0},
        "media_type": {"enum": ["text/markdown", "application/json"]},
        "policy_profile": {"const": "grok-export-v14"}
      }
    }
  }
}
