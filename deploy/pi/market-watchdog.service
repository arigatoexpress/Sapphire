[Unit]
Description=Sapphire Market Watchdog Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rari
WorkingDirectory=/home/rari/sapphire
ExecStart=/usr/bin/python3 /home/rari/sapphire/agents/market_watchdog.py --config /home/rari/sapphire/config/watchdog.yaml
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=market-watchdog

# Environment
EnvironmentFile=-/home/rari/sapphire/.env

# Resource limits — stay within 3.8GB RAM alongside Ollama
MemoryMax=256M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
