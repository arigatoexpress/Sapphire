# Sapphire control-plane defaults
# Primary host is passed via --target-host; failover hosts are auto-probed when lane is unhealthy.
# Set SAPPHIRECTL_FAILOVER_HOSTS via environment variable or local config (not committed).
# Example: export SAPPHIRECTL_FAILOVER_HOSTS=user@host1,user@host2
SAPPHIRECTL_FAILOVER_HOSTS=${SAPPHIRECTL_FAILOVER_HOSTS:-}
SAPPHIRECTL_LANE_LOOKBACK_MINUTES=45
