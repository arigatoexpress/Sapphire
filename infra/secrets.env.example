# Sapphire fresh-mac demo secrets template.
#
# Copy to ~/.sapphire/secrets.env with mode 0600. Values are placeholders by
# design: demo mode must not be able to contact real exchange, payment, or
# messaging APIs until an operator replaces the placeholders and flips the
# explicit live flags.

SAPPHIRE_DEMO_MODE=1
SAPPHIRE_BOOTSTRAP_DEMO_MODE=1
SAPPHIRE_LIVE_MODE=0
SAPPHIRE_DISABLE_EXTERNAL_APIS=1

# Local service defaults.
SAPPHIRE_REPO_PATH="${HOME}/Code/Sapphire"
SAPPHIRE_LOG_DIR="${HOME}/Library/Logs/sapphire"
AUTH_PASSWORD="CHANGE_ME_LOCAL_DEMO_PASSWORD"
USE_IN_MEMORY_STORE=true
TELEGRAM_DRY_RUN=1

# Trading and payment gates stay closed by default.
TRADINGVIEW_EXECUTION_ENABLED=false
SAPPHIRE_TRADING_LIVE=0
SAPPHIRE_ROBINHOOD_LIVE=0
SAPPHIRE_HYPERLIQUID_LIVE=0
SAPPHIRE_X402_LIVE=0
X402_ENABLED=0
SAPPHIRE_PUBLISH_LIVE=0

# External API keys. Replace only after moving out of demo mode.
TELEGRAM_BOT_TOKEN="PLACEHOLDER_DO_NOT_USE"
SAPPHIRE_PM_BOT_ALLOWED_USER_IDS=""
SAPPHIRE_PM_BOT_ALLOWED_USER_IDS_FILE="$HOME/.config/sapphire-secrets/sapphire_pm_bot_allowed_user_ids"
MOONSHOT_API_KEY="PLACEHOLDER_DO_NOT_USE"
OPENAI_API_KEY="PLACEHOLDER_DO_NOT_USE"
GEMINI_API_KEY="PLACEHOLDER_DO_NOT_USE"
GOOGLE_API_KEY="PLACEHOLDER_DO_NOT_USE"
FOUNDRY_TOKEN="PLACEHOLDER_DO_NOT_USE"
ROBINHOOD_API_KEY="PLACEHOLDER_DO_NOT_USE"
ROBINHOOD_PRIVATE_KEY="PLACEHOLDER_DO_NOT_USE"
HYPERLIQUID_PRIVATE_KEY="PLACEHOLDER_DO_NOT_USE"
