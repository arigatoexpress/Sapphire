# ── rari2 shared environment — source this in each service .env ────────────
# Redis pub/sub broker on rari1
REDIS_URL=redis://100.120.191.1:6379

# Service identity
SERVICE_NAME=rari2
HOSTNAME=rari2

# Signal routing
ALPHA_ENGINE_PORT=18081
CONTROL_PLANE_URL=http://100.120.191.1:8082
CONTROL_PLANE_TOKEN=<same token as rari1>

# GCP — leave blank for on-prem
# GCP_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT=

# Agentic control plane (connects to rari1's SQLite over Tailscale is not ideal)
# For rari2, use HTTP endpoint on rari1 control-plane instead of local DB
AGENTIC_CONTROL_PLANE_STORE_BACKEND=sqlite
AGENTIC_CONTROL_PLANE_DB_PATH=/home/rari/sapphire/control_plane.db

# ProtonVPN
PROTONVPN_ENABLED=true
