# ── rari1 shared environment — source this in each service .env ────────────
# Redis pub/sub broker (replaces GCP Pub/Sub)
REDIS_URL=redis://100.120.191.1:6379

# Service identity
SERVICE_NAME=rari1
HOSTNAME=rari1

# Tailscale mesh IPs
RARI1_IP=100.120.191.1
RARI2_IP=100.87.225.89
WINDOWS_IP=100.71.10.48
MAC_IP=100.67.171.79

# Alpha engine (receives signals from webhook)
ALPHA_ENGINE_PORT=18081

# Control plane PM bridge
CONTROL_PLANE_URL=http://100.120.191.1:8082
CONTROL_PLANE_TOKEN=<generate with: openssl rand -hex 32>

# GCP — leave blank for on-prem
# GCP_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT=

# Agentic control plane store (SQLite, on SSD)
AGENTIC_CONTROL_PLANE_STORE_BACKEND=sqlite
AGENTIC_CONTROL_PLANE_DB_PATH=/mnt/ssd/sapphire/control_plane.db
AGENTIC_RUNTIME_POLICY_BACKEND=file
AGENTIC_RUNTIME_POLICY_PATH=/mnt/ssd/sapphire/agent_runtime_policy.json

# Events log
SAPPHIRE_EVENTS_PATH=/mnt/ssd/sapphire/events/system_events.jsonl
