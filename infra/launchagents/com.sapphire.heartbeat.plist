<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/services/heartbeat/heartbeat.py</string>
    </array>

    <!-- KeepAlive daemon — launchd restarts if the process exits -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Don't restart faster than every 60s on crash -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
        <key>SAPPHIRE_SECRETS_DIR</key>
        <string>/Users/aribs/.config/sapphire-secrets</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/heartbeat.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/heartbeat-err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>
</dict>
</plist>
