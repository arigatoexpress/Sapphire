<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template only. Copy to ~/Library/LaunchAgents/, edit env, then `launchctl load`.
     Forwarder is gated by SAPPHIRE_MEGAETH_INGEST_ENABLED=1 — default 0 keeps it
     read-only-no-forward, useful for soak-testing the WS reconnect logic alone. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sapphire.megaeth-ingest</string>
  <key>WorkingDirectory</key>
  <string>/Users/aribs/Code/Sapphire</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>-m</string>
    <string>megaeth_ingest.main</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONPATH</key>
    <string>/Users/aribs/Code/Sapphire/services/megaeth-ingest/src:/Users/aribs/Code/Sapphire</string>
    <key>SAPPHIRE_MEGAETH_INGEST_ENABLED</key>
    <string>0</string>
    <key>SAPPHIRE_MEGAETH_HEALTH_PORT</key>
    <string>8788</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/aribs/autonomy-status/logs/megaeth-ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aribs/autonomy-status/logs/megaeth-ingest.err</string>
</dict>
</plist>
