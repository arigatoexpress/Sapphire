<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.lead-pipeline</string>

    <!-- Monday 09:00 — fresh permits/311 from the prior week, before the
         Monday morning brief at 08:00 picks up the result on Tuesday. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>-m</string>
        <string>lib.intel.pipeline</string>
        <string>--run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/lead-pipeline.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/lead-pipeline.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
