<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.tdr-pro-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/services/pipeline/tdr_pro_sync.py</string>
    </array>

    <!-- Daily at 08:00 local; TDR Pro drops Wednesday mornings US time -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>SAPPHIRE_TDR_PRO_LIVE</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/tdr-pro-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/tdr-pro-sync-err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>
</dict>
</plist>
