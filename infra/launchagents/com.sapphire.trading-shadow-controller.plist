<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.trading-shadow-controller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/scripts/ops/trading_shadow_controller.py</string>
        <string>--output</string>
    </array>

    <!-- Paper-shadow market screening only; no Robinhood credentials or submit path. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/trading-shadow-controller.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/trading-shadow-controller.err</string>

    <key>RunAtLoad</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
