<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.mac-to-windows-tunnel</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-o</string>
        <string>StrictHostKeyChecking=no</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-N</string>
        <string>-R</string>
        <string>6900:localhost:6900</string>
        <string>-R</string>
        <string>8080:localhost:8080</string>
        <string>-R</string>
        <string>18081:localhost:18081</string>
        <string>aribs@100.71.10.48</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aribs/autonomy-status/logs/mac_tunnel.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/autonomy-status/logs/mac_tunnel.err</string>
</dict>
</plist>
