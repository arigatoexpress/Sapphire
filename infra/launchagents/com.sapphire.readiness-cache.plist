<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.readiness-cache</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/scripts/ops/production_readiness_sweep.py</string>
        <string>--json</string>
        <string>--output</string>
        <string>/Users/aribs/autonomy-status/logs/readiness-sweep-latest.json</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/aribs/autonomy-status/logs/readiness-cache.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/autonomy-status/logs/readiness-cache.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
