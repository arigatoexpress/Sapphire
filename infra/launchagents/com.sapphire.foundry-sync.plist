<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.foundry-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/services/foundry_sync/sync.py</string>
    </array>

    <!-- Every 15 minutes -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
        <key>SAPPHIRE_SECRETS_DIR</key>
        <string>/Users/aribs/.config/sapphire-secrets</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/foundry-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/foundry-sync-err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>
</dict>
</plist>
