<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.content-publisher</string>

    <!--
      Runs 15 minutes after com.sapphire.content-engine so the engine has
      time to finish writing drafts to data/content/ready/. The publisher
      picks up anything new in the last 48h that hasn't already been
      pushed (idempotency ledger at data/content/published_ledger.json).

      Flip SAPPHIRE_PUBLISH_LIVE=1 below after verifying a full dry-run
      ledger + Telegram summary look correct. Keep it unset to stay in
      dry-run mode.
    -->

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>-m</string>
        <string>lib.content.auto_publish</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
        <!-- Default is dry-run. Change to 1 once you're confident. -->
        <key>SAPPHIRE_PUBLISH_LIVE</key>
        <string>0</string>
        <!-- Loaded via launchctl setenv in setup; keys are NOT in this file. -->
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/content-publisher.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/content-publisher.err</string>

    <key>RunAtLoad</key>
    <false/>

    <key>ThrottleInterval</key>
    <integer>3600</integer>
</dict>
</plist>
