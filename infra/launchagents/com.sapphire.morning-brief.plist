<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.morning-brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>/Users/aribs/Code/Sapphire/services/intelligence/daily_brief.py</string>
    </array>

    <!-- Fire at 06:00 local (MDT = UTC-6) = 07:00 CDT = 12:00 UTC -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Source Robinhood + Telegram credentials from secrets dir -->
    <!-- RobinhoodReader loads from ~/.config/sapphire-secrets/ directly (no env var needed) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>SAPPHIRE_SECRETS_DIR</key>
        <string>/Users/aribs/.config/sapphire-secrets</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/morning-brief.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Code/Sapphire/data/logs/morning-brief-err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>
</dict>
</plist>
