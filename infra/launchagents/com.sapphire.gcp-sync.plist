<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.gcp-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>-m</string>
        <string>services.pipeline.gcp_sync</string>
    </array>

    <!-- Hourly: 5 min past every hour -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>5</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
        <key>GOOGLE_APPLICATION_CREDENTIALS</key>
        <string>/Users/aribs/.config/gcloud/application_default_credentials.json</string>
        <key>GOOGLE_CLOUD_PROJECT</key>
        <string>tho-ai-agent</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/gcp-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/gcp-sync.err</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- Prevent overlapping runs -->
    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
