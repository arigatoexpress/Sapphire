# Copy to .env and fill. NEVER commit real secrets.
# Get keys: https://developer.x.com/ → Project → Keys and tokens
# App permissions must include Read AND Write (User auth / OAuth 1.0a).

# --- @rariwrldd ---
X_RARI_API_KEY=
X_RARI_API_SECRET=
X_RARI_ACCESS_TOKEN=
X_RARI_ACCESS_TOKEN_SECRET=

# --- @0guard_ (separate user tokens if different account) ---
X_0GUARD_API_KEY=
X_0GUARD_API_SECRET=
X_0GUARD_ACCESS_TOKEN=
X_0GUARD_ACCESS_TOKEN_SECRET=

# Optional: same app keys for both if both accounts authorized the same app
# Leave 0guard keys blank only if you will not run that account.
