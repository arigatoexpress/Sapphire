# 0G hackathon — example env. Copy to `.env` and fill in. NEVER commit `.env`.

# Toggle. Without this, the entire 0G integration is inert.
SAPPHIRE_OG_ENABLED=1

# Which 0G network to target. testnet (16602) or mainnet (16661).
SAPPHIRE_OG_NETWORK=testnet

# Hex private key (with or without 0x prefix) for the wallet that will:
#   - deploy contracts via scripts/deploy_og_chain.py
#   - publish signals via plugins/claw-sapphire/tools/og_publish.py
# Use a hot wallet, never the keys that hold real money.
OG_PRIVATE_KEY=

# 0G Compute provider. Get one from `0g-compute-cli inference list-providers`.
OG_COMPUTE_PROVIDER_ADDRESS=
OG_COMPUTE_BASE_URL=
OG_COMPUTE_API_KEY=
OG_COMPUTE_MODEL=

# Grok mac-bridge (plant local; Claude wired services/grok-bridge :19998)
GROK_BRIDGE_URL=http://127.0.0.1:19998
# GROK_BRIDGE_TOKEN=
