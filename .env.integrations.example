# Sapphire — Web Integrations Environment
#
# Copy to `.env.integrations` (git-ignored) and fill in real values.
# `lib.content.auto_publish` and the chain providers load these lazily.
# Never commit a filled-in copy.
#
# For production: store in GCP Secret Manager and inject via the
# LaunchAgent setup script (`scripts/load_integrations_env.sh`).
#
# Load into launchd (so LaunchAgents see these vars):
#   chmod 600 .env.integrations        # required — script refuses looser perms
#   scripts/load_integrations_env.sh   # loads all non-blank KEY=VALUE entries
#   scripts/load_integrations_env.sh --unset   # wipes them (safe reset)
#
# =========================================================================
# CONTENT PUBLISHING
# =========================================================================

# Master kill-switch. Clients stay in dry-run unless this is "1"/"true".
SAPPHIRE_PUBLISH_LIVE=0

# -- LinkedIn UGC Posts API ------------------------------------------------
# Scope: w_member_social (personal) or w_organization_social (company page)
# Get a token at: https://www.linkedin.com/developers/apps
# 3-legged OAuth, tokens expire after 60 days.
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:{id}  for personal posts
# urn:li:organization:{id}  for Kadima Digital company page
LINKEDIN_AUTHOR_URN=

# -- X (Twitter) API v2 ----------------------------------------------------
# User-context OAuth 1.0a — required to actually post.
# Get at https://console.x.com (the new Developer Console).
# As of 2026-04-18, X is on PAY-PER-USE consumption billing (no more
# Free/Basic/Pro monthly tiers). Posts cost ~cents each; buy credits
# once, no fixed monthly cost. Link the xAI team in console.x.com for
# free credits.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Optional bearer (read-only endpoints):
X_BEARER_TOKEN=

# -- Typefully (fallback for X scheduled posts) ----------------------------
# https://typefully.com/settings/integrations  — free tier: 1 scheduled thread/day
TYPEFULLY_API_KEY=

# -- Substack (via Resend email-to-post) ----------------------------------
# NOTE (2026-04-18): Substack does NOT expose a generic post-by-email
# address for standard accounts. Leave SUBSTACK_POST_EMAIL blank and the
# smoke test + auto_publish will cleanly SKIP — the content engine still
# drops rendered markdown into data/content/ready/ for manual paste.
# If Substack ever enables partner email-intake for this account, set
# the address here.
SUBSTACK_POST_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional — undocumented Substack draft endpoint; enables direct-draft path.
# Cookie expires fast (hours), not practical for automation. Leave blank.
SUBSTACK_SESSION_COOKIE=

# =========================================================================
# ON-CHAIN DATA PROVIDERS (lib/chain/providers)
# =========================================================================

# BTC on-chain metrics (MVRV, SOPR, NVT). Free tier ~500 req/day.
BGEOMETRICS_API_KEY=

# Social + on-chain metrics via GraphQL. Free tier: 600 queries/month.
SANTIMENT_API_KEY=

# Custom SQL on blockchain data. Free tier: 1,000 executions/month.
DUNE_API_KEY=

# Whale transaction alerts. Free "Personal" tier: 60 req/hour, min_value=500k.
WHALE_ALERT_API_KEY=

# Historical OHLCV + funding. Free tier: 100 req/day.
COINAPI_KEY=

# OI, funding, liquidation maps. Free tier: 30 req/min.
COINGLASS_API_KEY=

# No API — tracked at checkonchain.com manually. No env var needed.

# =========================================================================
# RESEND (shared between Substack email-to-post and THO transactional mail)
# =========================================================================
# See above for RESEND_API_KEY + RESEND_FROM_EMAIL.
# For THO (texashomeoutlet.com) flow, also set:
RESEND_THO_DOMAIN=texashomeoutlet.com
RESEND_THO_FROM=hello@texashomeoutlet.com

# =========================================================================
# CLOUDFLARE (optional — for the tunnel verifier script)
# =========================================================================
# API token scopes required:
#   - Account → Cloudflare Tunnel → Read
#   - Zone → Zone → Read
# Create a custom token at https://dash.cloudflare.com/profile/api-tokens
# Token name suggested: sapphire-tunnel-monitor
# Account ID is visible in any dashboard URL: dash.cloudflare.com/<ACCOUNT_ID>/...
# Ari's account ID is 75d6d9fd102b3f4f56a10a5a24005d68 — paste it directly.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# =========================================================================
# GCP (already handled by gcloud auth application-default login)
# =========================================================================
# Only needed if running outside the user's gcloud session:
# GOOGLE_APPLICATION_CREDENTIALS=/Users/aribs/.config/gcloud/tho-ai-agent.json
# GCP_PROJECT_ID=tho-ai-agent

# Grok mac-bridge (plant local; Claude wired services/grok-bridge :19998)
GROK_BRIDGE_URL=http://127.0.0.1:19998
# GROK_BRIDGE_TOKEN=
