# ==============================================================================
# Sapphire V2 Microservices - Backend Only Dockerfile
# Python Runtime for Trading Services (No Frontend)
# ==============================================================================

FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PORT=8080

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --no-deps lighter-sdk || echo "lighter-sdk install skipped"

# Copy application code
COPY cloud_trader/ ./cloud_trader/
COPY internal/ ./internal/
COPY services/ ./services/
COPY *.py ./

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE $PORT

# Default command (can be overridden by Cloud Run)
CMD ["python", "-m", "cloud_trader.main"]
