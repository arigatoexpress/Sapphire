# Sapphire Trading System - Shared Configuration
# Copy this file to trading.env and fill in your actual credentials
# DO NOT commit trading.env to git - it contains sensitive data

# ============================================
# EXCHANGE CONFIGURATION
# ============================================
# Lighter Exchange (Primary)
LIGHTER_API_KEY=your_lighter_api_key_here
LIGHTER_API_SECRET=your_lighter_api_secret_here
LIGHTER_ACCOUNT_INDEX=1

# Aster Exchange (If applicable)
ASTER_API_KEY=your_aster_api_key_here
ASTER_SECRET_KEY=your_aster_secret_key_here

# ============================================
# TRADING PARAMETERS
# ============================================
# Risk Management
MAX_DAILY_TRADES=10
MAX_TRADE_SIZE_USD=5.00
ENABLE_PAPER_TRADING=false

# Trading Hours (24h format, ET)
TRADING_START_HOUR=9
TRADING_END_HOUR=16

# ============================================
# AI/ML CONFIGURATION
# ============================================
# Vertex AI (for trade analysis)
ENABLE_VERTEX_AI=true
GEMINI_API_KEY=your_gemini_api_key_here

# Grok/xAI (optional)
GROK_API_KEY=your_grok_api_key_here

# ============================================
# NOTIFICATIONS
# ============================================
# Telegram Bot
ENABLE_TELEGRAM=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ============================================
# INFRASTRUCTURE
# ============================================
# Pub/Sub (GCP)
ENABLE_PUBSUB=true
GCP_PROJECT_ID=sapphire-479610

# PM Hub Integration
CONTROL_PLANE_BASE_URL=https://agentic-pm-hub-267358751314.us-central1.run.app
CONTROL_PLANE_SHARED_TOKEN=your_pm_token_here

# ============================================
# NETWORKING
# ============================================
# VPN Configuration
ENABLE_VPN=true
VPN_PROVIDER=protonvpn
VPN_COUNTRY=CH

# Pi Cluster IPs
PI1_IP=10.0.0.1
PI2_IP=10.0.0.2
PI1_LOCAL_IP=192.168.1.23
PI2_LOCAL_IP=192.168.1.173

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/sapphire/trading.log