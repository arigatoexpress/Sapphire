// Sapphire RegimeAwareRSI — BTC-USD
// Generated by lib.pine_generation v0.1.0 at 2026-04-28T23:52:02+00:00
// Symbol: BINANCE:BTCUSDT  BTC ref: CRYPTOCAP:BTC
// Params: rsi=7 sl=2.00% tp=10.00% regime_period=20
// NOTE: This is auto-generated Pine — paper-test in TradingView before going live.

//@version=5
strategy("Sapphire RegimeAwareRSI – BTC-USD", overlay=true, initial_capital=1000.0, default_qty_type=strategy.percent_of_equity, default_qty_value=11.5, commission_type=strategy.commission.percent, commission_value=0.05)

// Inputs
rsi_len             = input.int(7, "RSI Length", minval=2, maxval=200)
regime_period       = input.int(20, "Regime Period (bars)", minval=2, maxval=400)
regime_on_threshold = input.float(0.0500, "Regime ON Threshold (frac)", minval=-1.0, maxval=1.0)
regime_off_threshold= input.float(-0.0500, "Regime OFF Threshold (frac)", minval=-1.0, maxval=1.0)
sl_pct              = input.float(2.00, "Stop Loss %", minval=0.1, maxval=50.0) / 100.0
tp_pct              = input.float(10.00, "Take Profit %", minval=0.1, maxval=200.0) / 100.0

// Aux: BTC reference price for regime detection (matches Python aux["btc"]).
btc_close = request.security("CRYPTOCAP:BTC", timeframe.period, close, lookahead=barmerge.lookahead_off)

// Regime detection: regime_period-bar momentum on BTC reference
btc_old = btc_close[regime_period]
btc_mom = btc_old > 0.0 ? (btc_close - btc_old) / btc_old : 0.0
is_risk_on  = btc_mom >= regime_on_threshold
is_risk_off = btc_mom <= regime_off_threshold
is_transition = not is_risk_on and not is_risk_off

// Indicators
rsi = ta.rsi(close, rsi_len)

// Signals (RSI mean-reversion gated by regime)
rsi_threshold = is_risk_on ? 30.0 : 25.0
long_cond     = not is_risk_off and rsi < rsi_threshold
exit_cond     = rsi > 70.0

// Entries / Exits
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="Sapphire RegimeAwareRSI Long")

if strategy.position_size > 0
    sl_level = strategy.position_avg_price * (1.0 - sl_pct)
    tp_level = strategy.position_avg_price * (1.0 + tp_pct)
    strategy.exit("Exit", from_entry="Long", stop=sl_level, limit=tp_level)

if exit_cond and strategy.position_size > 0
    strategy.close("Long", comment="RSI overbought")

if is_risk_off and strategy.position_size > 0
    strategy.close("Long", comment="Regime OFF — flat")

// Diagnostics
plot(rsi, "RSI", color=color.new(color.purple, 0))
hline(30.0, "Oversold", color=color.new(color.green, 50))
hline(70.0, "Overbought", color=color.new(color.red, 50))
bgcolor(is_risk_on ? color.new(color.green, 92) : is_risk_off ? color.new(color.red, 92) : color.new(color.yellow, 95))
