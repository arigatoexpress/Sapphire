// Sapphire CorrelationBreakout — SPY
// Generated by lib.pine_generation v0.1.0 at 2026-04-28T23:52:02+00:00
// Symbol: AMEX:SPY  SPY ref: AMEX:SPY
// Params: rsi=7 sl=2.00% tp=5.00% corr_period=20 corr_threshold=0.3000
// NOTE: Auto-generated Pine — paper-test in TradingView before going live.

//@version=5
strategy("Sapphire CorrelationBreakout – SPY", overlay=true, initial_capital=1000.0, default_qty_type=strategy.percent_of_equity, default_qty_value=9.3, commission_type=strategy.commission.percent, commission_value=0.05)

// Inputs
rsi_len        = input.int(7, "RSI Length", minval=2, maxval=200)
corr_period    = input.int(20, "Correlation Period (bars)", minval=3, maxval=200)
corr_threshold = input.float(0.3000, "Correlation Threshold", minval=-1.0, maxval=1.0)
sl_pct         = input.float(2.00, "Stop Loss %", minval=0.1, maxval=50.0) / 100.0
tp_pct         = input.float(5.00, "Take Profit %", minval=0.1, maxval=200.0) / 100.0

// Aux: SPY reference price (matches Python aux["spy"])
spy_close = request.security("AMEX:SPY", timeframe.period, close, lookahead=barmerge.lookahead_off)

// Daily returns (1-bar)
sym_ret = (close - close[1]) / close[1]
spy_ret = (spy_close - spy_close[1]) / spy_close[1]

// Rolling correlation across corr_period bars
btc_spy_corr = ta.correlation(sym_ret, spy_ret, corr_period)

// RSI gate
rsi = ta.rsi(close, rsi_len)

// Signals: when crypto decouples (corr below threshold) AND RSI oversold => long
decoupled  = btc_spy_corr < corr_threshold
long_cond  = decoupled and rsi < 45.0
exit_cond  = rsi > 65.0

// Entries / Exits
if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="Sapphire CorrelationBreakout Long")

if strategy.position_size > 0
    sl_level = strategy.position_avg_price * (1.0 - sl_pct)
    tp_level = strategy.position_avg_price * (1.0 + tp_pct)
    strategy.exit("Exit", from_entry="Long", stop=sl_level, limit=tp_level)

if exit_cond and strategy.position_size > 0
    strategy.close("Long", comment="RSI rolled over")

// Diagnostics
plot(btc_spy_corr, "BTC↔SPY Correlation", color=color.new(color.aqua, 0))
hline(corr_threshold, "Threshold", color=color.new(color.yellow, 50))
hline(0.0, "Zero", color=color.new(color.gray, 50))
