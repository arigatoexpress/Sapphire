// Sapphire MultiTFMomentum — SPY
// Generated by lib.pine_generation v0.1.0 at 2026-04-28T23:52:02+00:00
// Symbol: AMEX:SPY
// Params: rsi=7 sl=5.00% tp=15.00% tf_fast=7 tf_slow=5
// NOTE: Auto-generated Pine — paper-test in TradingView before going live.

//@version=5
strategy("Sapphire MultiTFMomentum – SPY", overlay=true, initial_capital=1000.0, default_qty_type=strategy.percent_of_equity, default_qty_value=10.0, commission_type=strategy.commission.percent, commission_value=0.05)

// Inputs
rsi_len = input.int(7, "RSI Length (base)", minval=2, maxval=200)
tf_fast = input.int(7, "TF Fast (RSI period, 4H proxy)", minval=2, maxval=100)
tf_slow = input.int(5, "TF Slow (weekly bar count)", minval=2, maxval=100)
sl_pct  = input.float(5.00, "Stop Loss %", minval=0.1, maxval=50.0) / 100.0
tp_pct  = input.float(15.00, "Take Profit %", minval=0.1, maxval=200.0) / 100.0

// 3 timeframe proxies (Python: rsi_fast=tf_fast, sma20, weekly_ret=tf_slow-bar return)
rsi_fast    = ta.rsi(close, tf_fast)
sma20       = ta.sma(close, 20)
weekly_old  = close[tf_slow]
weekly_ret  = weekly_old > 0.0 ? (close - weekly_old) / weekly_old : 0.0

// All-three-agree gate
bull = rsi_fast < 40.0 and close < sma20 and weekly_ret < 0.0
bear = rsi_fast > 65.0 and close > sma20 * 1.02 and weekly_ret > 0.02

// Entries / Exits
if bull and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="Sapphire MultiTFMomentum Long")

if strategy.position_size > 0
    sl_level = strategy.position_avg_price * (1.0 - sl_pct)
    tp_level = strategy.position_avg_price * (1.0 + tp_pct)
    strategy.exit("Exit", from_entry="Long", stop=sl_level, limit=tp_level)

if bear and strategy.position_size > 0
    strategy.close("Long", comment="Multi-TF bear")

// Diagnostics
plot(rsi_fast, "RSI Fast", color=color.new(color.purple, 0))
plot(sma20, "SMA 20", color=color.new(color.orange, 0))
hline(40.0, "RSI Fast Bull Trigger", color=color.new(color.green, 50))
