<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.dashboard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/aribs/Code/Sapphire/services/dashboard/start.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire/services/dashboard</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- app.py aborts at import when AUTH_PASSWORD is unset or weak. Without a
         throttle, KeepAlive respawns that crash on launchd's 1s floor and
         buries the real error under a log flood. 30s keeps the restart useful
         while making a crash-loop legible. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <!-- 8080 is squatted by com.sovereign.openwebui and app.py's own
             default 8082 collides with control-plane. 8085 is the free slot. -->
        <key>PORT</key>
        <string>8085</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/autonomy-status/logs/dashboard.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/autonomy-status/logs/dashboard.err</string>
</dict>
</plist>
