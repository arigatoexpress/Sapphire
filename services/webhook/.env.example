# ── Webhook Receiver — Windows PC configuration ─────────────────────────────
# Copy to C:\sapphire\webhook\.env

# Webhook auth — must match Pine Script alert body "secret" field
WEBHOOK_SECRET=replace-with-long-random-secret
WEBHOOK_MAX_BODY_BYTES=8192

# Signal routing over Tailscale — api-gateway endpoints
ALPHA_ENGINE_RARI1=http://100.120.191.1:18080
ALPHA_ENGINE_RARI2=http://100.87.225.89:18080

# Auth token for /api/signals/create (SAPPHIRE_CONTROL_API_TOKEN on the Pis)
SAPPHIRE_CONTROL_API_TOKEN=

# Local Ollama for signal enrichment (RTX 5070 Ti)
OLLAMA_URL=http://localhost:11434

# Port
WEBHOOK_PORT=9090

# Log files (Windows defaults match historical C:\sapphire layout; set explicitly
# on Mac/Linux or rely on ~/.local/share/sapphire/ platform defaults)
WEBHOOK_LOG_FILE=C:\sapphire\webhook.log
ALERT_LOG_FILE=C:\sapphire\webhook\alerts.jsonl

# Capability sync interval (seconds)
CAPABILITY_SYNC_INTERVAL_SECONDS=180
