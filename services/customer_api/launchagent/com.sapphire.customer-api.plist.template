<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.customer-api</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/python3</string>
        <string>-m</string>
        <string>services.customer_api.app</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire</string>
        <key>SAPPHIRE_CUSTOMER_API_LIVE</key>
        <string>0</string>
        <key>SAPPHIRE_CUSTOMER_PAYMENT_INFRA_VERIFIED</key>
        <string>0</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/customer-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire/customer-api.err</string>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>
    <key>ThrottleInterval</key>
    <integer>300</integer>
</dict>
</plist>
