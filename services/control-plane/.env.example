# ── Control Plane — on-prem (rari1) configuration ──────────────────────────
# Copy to .env and fill in secrets.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_TELEGRAM_USER_IDS=
ALLOWED_TELEGRAM_CHAT_IDS=

# Auth
JOB_SHARED_TOKEN=
CONTROL_PLANE_SHARED_TOKEN=
CONTROL_PLANE_TOKEN=

# Storage — in-memory by default when NOT on Cloud Run (auto-detected)
# Set USE_IN_MEMORY_STORE=true to force, or omit (auto on rari1)
# USE_IN_MEMORY_STORE=true

# SQLite backend for control_plane tasks (default: ~/.sapphire/control_plane.db)
# AGENTIC_CONTROL_PLANE_STORE_BACKEND=sqlite
# AGENTIC_CONTROL_PLANE_DB_PATH=/mnt/ssd/sapphire/control_plane.db

# Runtime policy (local JSON — no GCP needed)
AGENTIC_RUNTIME_POLICY_BACKEND=file
AGENTIC_RUNTIME_POLICY_PATH=/mnt/ssd/sapphire/agent_runtime_policy.json

# Events log
SAPPHIRE_EVENTS_PATH=/mnt/ssd/sapphire/events/system_events.jsonl

# Public URL — only needed if registering Telegram webhook
# For Cloudflare Tunnel: set to your tunnel hostname
PUBLIC_BASE_URL=
STARTUP_REGISTER_WEBHOOK=false

# GCP — NOT needed for on-prem. Leave blank.
# GCP_PROJECT_ID=sapphire-479610

# Digest / news settings
DIGEST_TOP_K=7
MIN_ALPHA_SCORE=35
MAX_NEWS_AGE_HOURS=20
HEARTBEAT_INTERVAL_MINUTES=60
TIMEZONE=UTC

# Default assets tracked
DEFAULT_ASTER_ASSETS=AAPL,TSLA,NVDA,GOLD,SILVER
DEFAULT_LIGHTER_ASSETS=WETH,WBTC,SOL,LINK,UNI
DEFAULT_MACRO_KEYWORDS=fed,interest rate,cpi,inflation,etf,liquidity,regulation,earnings

PORT=8082
