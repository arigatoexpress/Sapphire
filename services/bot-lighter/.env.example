# =============================================================================
# bot-lighter — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — credentials must stay off-disk.
# =============================================================================

# ── Service identity ──────────────────────────────────────────────────────────
# rari1: bot-lighter-pi-rari1
# rari2: bot-lighter-pi
SERVICE_NAME=bot-lighter-pi

# ── Lighter Protocol ──────────────────────────────────────────────────────────
# Account and API key configuration
LIGHTER_ACCOUNT_INDEX=699444          # Your Lighter Protocol account index
LIGHTER_API_KEY_INDEX=0               # Index of the API key to use (0, 1, 2...)

# Public key — retrieve from: lighter.AccountApi.apikeys(account_index, api_key_index)
LIGHTER_PUB_KEY=<your-80-char-hex-pubkey>

# Private key — 40 bytes (80 hex chars). KEEP SECURE.
LIGHTER_PRIV_KEY=<your-80-char-hex-privkey>

# Must match LIGHTER_API_KEY_INDEX (required by SignerClient)
LIGHTER_API_SECRET_0=<your-80-char-hex-privkey>

# Skip VPN-geofenced validation on startup (required on rari1, set on rari2 too)
LIGHTER_SKIP_VALIDATION=true

# Exchange API URL
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai

# ── Google Cloud Pub/Sub ──────────────────────────────────────────────────────
PUBSUB_PROJECT_ID=sapphire-479610
GCP_PROJECT_ID=sapphire-479610        # Alias used by some shared modules

# Subscription ID — bot auto-creates: {topic}-{SERVICE_NAME}-sub
# rari1: lighter-signals-rari1
# rari2: lighter-signals (or trading-signals-bot-lighter-pi-sub)
PUBSUB_SUBSCRIPTION_ID=lighter-signals

# Path to GCP service account JSON (pi-trading-agent)
GOOGLE_APPLICATION_CREDENTIALS=/home/rari/.config/gcp/pi-trading-agent.json

# ── Trading mode ──────────────────────────────────────────────────────────────
# rari1: paper mode (monitoring only, no VPN)
# rari2: live mode (ProtonVPN Switzerland, executes real trades)
TRADING_MODE=live                     # live | paper
ALLOW_LIVE_TRADING=1                  # 1=live, 0=paper/dry-run
MAX_NOTIONAL_USD=250                  # Maximum position size in USD

# Optional sizing controls:
# Target margin per entry in USD. If leverage mode is enabled, gross notional
# becomes: LIGHTER_TARGET_ORDER_NOTIONAL_USD * LIGHTER_TARGET_ORDER_LEVERAGE.
LIGHTER_TARGET_ORDER_NOTIONAL_USD=4
LIGHTER_MIN_ENTRY_NOTIONAL_USD=4.0
LIGHTER_MIN_ADD_NOTIONAL_USD=4.0
LIGHTER_CAP_NEAR_CHURN_ENABLED=true
LIGHTER_CAP_NEAR_CHURN_RATIO=0.90
LIGHTER_CAP_NEAR_MIN_NET_EV_PCT=0.10
LIGHTER_CAP_NEAR_MIN_EV_EDGE_PCT=0.20
LIGHTER_USE_LEVERAGE_FOR_NOTIONAL=true
LIGHTER_TARGET_ORDER_LEVERAGE=20
LIGHTER_MAX_SIGNAL_LEVERAGE=20
LIGHTER_ORDER_SUBMIT_RETRY_ATTEMPTS=2
LIGHTER_ORDER_SUBMIT_RETRY_BACKOFF_SECONDS=0.75

# Net EV model (fee/slippage-aware)
LIGHTER_EV_MAKER_FEE_BPS=1.5
LIGHTER_EV_TAKER_FEE_BPS=4.5
LIGHTER_EV_EXPECTED_TAKER_RATIO=1.0
LIGHTER_EV_SLIPPAGE_BASE_BPS=1.5
LIGHTER_EV_SLIPPAGE_VOL_MULT_BPS=2.0
LIGHTER_EV_SLIPPAGE_NOTIONAL_REF_USD=4.0
LIGHTER_EV_SLIPPAGE_NOTIONAL_MULT_BPS=2.0

# Optional strict entry scope (comma-separated normalized symbols: BTC,ETH,SOL).
# Empty means no symbol allowlist filter.
LIGHTER_ENTRY_SYMBOL_ALLOWLIST=SOL

# Gross notional caps (post-leverage) for order/position/portfolio.
LIGHTER_MAX_ORDER_NOTIONAL_USD=80
LIGHTER_MAX_POSITION_NOTIONAL_USD=80
LIGHTER_MAX_PORTFOLIO_NOTIONAL_USD=80

# Hard fail-closed risk kernel (entry gating only; exits still allowed).
LIGHTER_HARD_RISK_KERNEL_ENABLED=true
LIGHTER_HARD_RISK_HOLD_SECONDS=1800
LIGHTER_HARD_RISK_MAX_DAILY_LOSS_PCT=4.0
LIGHTER_HARD_RISK_MAX_DAILY_LOSS_USD=0
LIGHTER_HARD_RISK_MAX_INTRADAY_DRAWDOWN_PCT=3.5
LIGHTER_HARD_RISK_MAX_CONSECUTIVE_LOSS_EVENTS=4
LIGHTER_HARD_RISK_MAX_CONSECUTIVE_HARD_FAILS=5
LIGHTER_HARD_RISK_LOSS_EVENT_MIN_DELTA_USD=0.15

# Operator go/no-go + reject-tax telemetry window
LIGHTER_REJECT_TAX_WINDOW_HOURS=24
LIGHTER_REJECT_TAX_CACHE_TTL_SECONDS=45
LIGHTER_REJECT_TAX_ALERT_PCT=65
LIGHTER_GO_NOGO_MAX_REJECT_TAX_PCT=75
LIGHTER_GO_NOGO_MAX_HARD_FAIL_PCT=10
LIGHTER_GO_NOGO_MIN_SAMPLE_SIZE=20
LIGHTER_GO_NOGO_GATE_ENABLED=true
LIGHTER_GO_NOGO_CACHE_TTL_SECONDS=20
LIGHTER_PLATFORM_DECISION_GATE_ENABLED=true
LIGHTER_PLATFORM_DECISION_URL=https://sapphirealpha.xyz/api/platform/strategy-ops?days=7
LIGHTER_PLATFORM_DECISION_CACHE_TTL_SECONDS=60
LIGHTER_PLATFORM_DECISION_TIMEOUT_SECONDS=3
LIGHTER_EQUITY_SNAPSHOT_CACHE_TTL_SECONDS=10

# Optional adaptive size-ramp (steps margin sizing up/down from execution quality).
LIGHTER_SIZE_RAMP_ENABLED=true
LIGHTER_SIZE_RAMP_MIN_MARGIN_USD=4.0
LIGHTER_SIZE_RAMP_MAX_MARGIN_USD=6.0
LIGHTER_SIZE_RAMP_STEP_MARGIN_USD=0.5
LIGHTER_SIZE_RAMP_MIN_SAMPLES=12
LIGHTER_SIZE_RAMP_UP_FILL_RATE=0.65
LIGHTER_SIZE_RAMP_DOWN_FILL_RATE=0.45
LIGHTER_SIZE_RAMP_MAX_HARD_FAIL_RATE=0.08
LIGHTER_SIZE_RAMP_ADJUST_COOLDOWN_SECONDS=300
LIGHTER_SIZE_RAMP_RECENT_STREAK=3

# ── Signal deduplication ──────────────────────────────────────────────────────
SIGNAL_DEDUPE_TTL_SECONDS=300         # How long to cache signal IDs (5 min)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
