# =============================================================================
# bot-lighter — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit .env to git — credentials must stay off-disk.
# =============================================================================

# ── Service identity ──────────────────────────────────────────────────────────
# rari1: bot-lighter-pi-rari1
# rari2: bot-lighter-pi
SERVICE_NAME=bot-lighter-pi

# ── Lighter Protocol ──────────────────────────────────────────────────────────
# Account and API key configuration
LIGHTER_ACCOUNT_INDEX=699444          # Your Lighter Protocol account index
LIGHTER_API_KEY_INDEX=0               # Index of the API key to use (0, 1, 2...)

# Public key — retrieve from: lighter.AccountApi.apikeys(account_index, api_key_index)
LIGHTER_PUB_KEY=<your-80-char-hex-pubkey>

# Private key — 40 bytes (80 hex chars). KEEP SECURE.
LIGHTER_PRIV_KEY=<your-80-char-hex-privkey>

# Must match LIGHTER_API_KEY_INDEX (required by SignerClient)
LIGHTER_API_SECRET_0=<your-80-char-hex-privkey>

# Skip VPN-geofenced validation on startup (required on rari1, set on rari2 too)
LIGHTER_SKIP_VALIDATION=true

# Exchange API URL
LIGHTER_API_URL=https://mainnet.zklighter.elliot.ai

# ── Google Cloud Pub/Sub ──────────────────────────────────────────────────────
PUBSUB_PROJECT_ID=sapphire-479610
GCP_PROJECT_ID=sapphire-479610        # Alias used by some shared modules

# Subscription ID — bot auto-creates: {topic}-{SERVICE_NAME}-sub
# rari1: lighter-signals-rari1
# rari2: lighter-signals (or trading-signals-bot-lighter-pi-sub)
PUBSUB_SUBSCRIPTION_ID=lighter-signals

# Path to GCP service account JSON (pi-trading-agent)
GOOGLE_APPLICATION_CREDENTIALS=/home/rari/.config/gcp/pi-trading-agent.json

# ── Trading mode ──────────────────────────────────────────────────────────────
# rari1: paper mode (monitoring only, no VPN)
# rari2: live mode (ProtonVPN Switzerland, executes real trades)
TRADING_MODE=live                     # live | paper
ALLOW_LIVE_TRADING=1                  # 1=live, 0=paper/dry-run
MAX_NOTIONAL_USD=250                  # Maximum position size in USD

# ── Signal deduplication ──────────────────────────────────────────────────────
SIGNAL_DEDUPE_TTL_SECONDS=300         # How long to cache signal IDs (5 min)

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
