<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sapphire.narrative-synthesis</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>/Users/aribs/Code/Sapphire/services/synthesis/run.py</string>
    <string>daemon</string>
    <string>--mode</string>
    <string>dry-run</string>
    <string>--poll-interval-seconds</string>
    <string>1800</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/aribs/Code/Sapphire</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/sapphire-narrative-synthesis.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/sapphire-narrative-synthesis.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SAPPHIRE_NARRATIVE_LIVE</key>
    <string>0</string>
    <key>SAPPHIRE_NARRATIVE_LIVE_BUS</key>
    <string>0</string>
  </dict>
</dict>
</plist>
