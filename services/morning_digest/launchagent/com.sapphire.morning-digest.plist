<?xml version="1.0" encoding="UTF-8"?>
<!-- Rationale: launchd already provides reliable local scheduling, so the
     digest runs once at 08:00 local time and exits instead of keeping another
     Python scheduler process alive. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sapphire.morning-digest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/aribs/Code/Sapphire/services/morning_digest/run_once.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/aribs/Code/Sapphire</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/aribs/Library/Logs/sapphire-morning-digest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/aribs/Library/Logs/sapphire-morning-digest.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/aribs</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONPATH</key>
        <string>/Users/aribs/Code/Sapphire/plugins/claw-sapphire/tools</string>
        <key>THO_FIRESTORE_PROJECT</key>
        <string>tho-ai-agent</string>
    </dict>
</dict>
</plist>
