# Sapphire (Active Stack) - Example Environment
#
# This file is intentionally minimal and reflects the CURRENT active paths:
# - services/alpha-engine (sapphire-alpha)
# - services/bot-aster (sapphire-aster)
# - services/bot-lighter (sapphire-lighter)
# - sapphire-web (Firebase Hosting)
#
# Do not commit real secrets. Production secrets live in GCP Secret Manager.

# ---- Alpha engine (Telegram + TradingView ingress) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
SAPPHIRE_CONTROL_API_TOKEN=

# Optional: proxy the /sapphire namespace to sapphire-control
OPENCLAW_TELEGRAM_PROXY_URL=
OPENCLAW_TELEGRAM_PROXY_TOKEN=

# Optional: agent gateway (OpenClaw)
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# Scope controls
ENABLED_VENUES=ASTER;LIGHTER

# Optional AI + security integrations
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VIRUSTOTAL_API_KEY=

# ---- Frontend (Vite/Vue) ----
# Point the web UI at sapphire-alpha (or another API base).
VITE_ALPHA_BASE_URL=https://sapphire-alpha-267358751314.us-central1.run.app

