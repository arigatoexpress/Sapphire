// Sapphire {{strategy_cls}} — {{symbol}}
// Generated by lib.pine_generation v{{version}} at {{generated_at}}
// Symbol: {{tv_symbol}}
// Params: sl={{sl_pct_str}}% tp={{tp_pct_str}}% funding_high={{funding_high_str}} funding_low={{funding_low_str}}
// NOTE: 3-day momentum is used as a funding-rate proxy. Auto-generated — paper-test before going live.

//@version=5
strategy("{{title}}", overlay=true, initial_capital={{initial_capital}}, default_qty_type=strategy.percent_of_equity, default_qty_value={{default_qty_value}}, commission_type=strategy.commission.percent, commission_value={{commission_pct}})

// Inputs
funding_high = input.float({{funding_high_str}}, "Funding High (3d mom)", minval=-1.0, maxval=1.0)
funding_low  = input.float({{funding_low_str}}, "Funding Low (3d mom)", minval=-1.0, maxval=1.0)
sl_pct       = input.float({{sl_pct_str}}, "Stop Loss %", minval=0.1, maxval=50.0) / 100.0
tp_pct       = input.float({{tp_pct_str}}, "Take Profit %", minval=0.1, maxval=200.0) / 100.0

// 3-day price momentum (funding-rate proxy)
c_prev   = close[3]
mom_3d   = c_prev > 0.0 ? (close - c_prev) / c_prev : 0.0

// Signals: high funding => crowded long => fade short; low funding => crowded short => fade long
long_cond  = mom_3d < funding_low
short_cond = mom_3d > funding_high

// Entries
if long_cond and strategy.position_size <= 0
    strategy.entry("Long", strategy.long, comment="Sapphire {{strategy_cls}} Long")

if short_cond and strategy.position_size >= 0
    strategy.entry("Short", strategy.short, comment="Sapphire {{strategy_cls}} Short")

// Exits with stop and take-profit on each side
if strategy.position_size > 0
    sl_level = strategy.position_avg_price * (1.0 - sl_pct)
    tp_level = strategy.position_avg_price * (1.0 + tp_pct)
    strategy.exit("ExitLong", from_entry="Long", stop=sl_level, limit=tp_level)

if strategy.position_size < 0
    sl_level = strategy.position_avg_price * (1.0 + sl_pct)
    tp_level = strategy.position_avg_price * (1.0 - tp_pct)
    strategy.exit("ExitShort", from_entry="Short", stop=sl_level, limit=tp_level)

// Diagnostics
plot(mom_3d, "3d Momentum", color=color.new(color.aqua, 0))
hline(funding_high, "Funding High", color=color.new(color.red, 50))
hline(funding_low, "Funding Low", color=color.new(color.green, 50))
hline(0.0, "Zero", color=color.new(color.gray, 50))
