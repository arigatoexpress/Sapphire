// Sapphire {{strategy_cls}} — {{symbol}}
// Generated by lib.pine_generation v{{version}} at {{generated_at}}
// Symbol: {{tv_symbol}}  BTC ref: {{btc_ref_symbol}}  SPY ref: {{spy_ref_symbol}}
// Params: rsi={{rsi_period}} sl={{sl_pct_str}}% tp={{tp_pct_str}}% composite_threshold={{composite_threshold_str}}
// Score components: regime(25) + RSI depth(25) + funding(20) + corr(15) + multi-TF(15)
// NOTE: Auto-generated Pine — paper-test in TradingView before going live.

//@version=5
strategy("{{title}}", overlay=true, initial_capital={{initial_capital}}, default_qty_type=strategy.percent_of_equity, default_qty_value={{default_qty_value}}, commission_type=strategy.commission.percent, commission_value={{commission_pct}})

// Inputs
rsi_len               = input.int({{rsi_period}}, "RSI Length", minval=2, maxval=200)
regime_period         = input.int({{regime_period}}, "Regime Period", minval=2, maxval=400)
regime_on_threshold   = input.float({{regime_on_threshold_str}}, "Regime ON Threshold", minval=-1.0, maxval=1.0)
regime_off_threshold  = input.float({{regime_off_threshold_str}}, "Regime OFF Threshold", minval=-1.0, maxval=1.0)
funding_high          = input.float({{funding_high_str}}, "Funding High (3d mom)", minval=-1.0, maxval=1.0)
funding_low           = input.float({{funding_low_str}}, "Funding Low (3d mom)", minval=-1.0, maxval=1.0)
corr_period           = input.int({{corr_period}}, "Corr Period (bars)", minval=3, maxval=200)
corr_threshold        = input.float({{corr_threshold_str}}, "Corr Threshold", minval=-1.0, maxval=1.0)
tf_fast               = input.int({{tf_fast}}, "TF Fast (4H proxy)", minval=2, maxval=100)
tf_slow               = input.int({{tf_slow}}, "TF Slow (weekly proxy)", minval=2, maxval=100)
composite_threshold   = input.float({{composite_threshold_str}}, "Composite Score Threshold", minval=0.0, maxval=100.0)
sl_pct                = input.float({{sl_pct_str}}, "Stop Loss %", minval=0.1, maxval=50.0) / 100.0
tp_pct                = input.float({{tp_pct_str}}, "Take Profit %", minval=0.1, maxval=200.0) / 100.0

// Aux: BTC and SPY reference series
btc_close = request.security("{{btc_ref_symbol}}", timeframe.period, close, lookahead=barmerge.lookahead_off)
spy_close = request.security("{{spy_ref_symbol}}", timeframe.period, close, lookahead=barmerge.lookahead_off)

// ── Component 1: Regime (0–25) ───────────────────────────────────────────
btc_old      = btc_close[regime_period]
btc_mom      = btc_old > 0.0 ? (btc_close - btc_old) / btc_old : 0.0
regime_score = btc_mom >= regime_on_threshold ? 25.0 : (btc_mom > regime_off_threshold ? 15.0 : 0.0)

// ── Component 2: RSI depth (0–25) ────────────────────────────────────────
rsi             = ta.rsi(close, rsi_len)
rsi_depth_score = rsi < 30.0 ? math.min(25.0, (30.0 - rsi) * 25.0 / 20.0) : (rsi > 70.0 ? -5.0 : 0.0)

// ── Component 3: Funding proxy (0–20) ────────────────────────────────────
c_prev          = close[3]
mom_3d          = c_prev > 0.0 ? (close - c_prev) / c_prev : 0.0
funding_score   = mom_3d < funding_low ? math.min(20.0, math.abs(mom_3d) * 300.0) : (mom_3d > funding_high ? -5.0 : 0.0)

// ── Component 4: Correlation decoupling (0–15) ───────────────────────────
sym_ret         = (close - close[1]) / close[1]
spy_ret         = (spy_close - spy_close[1]) / spy_close[1]
btc_spy_corr    = ta.correlation(sym_ret, spy_ret, corr_period)
corr_gap        = corr_threshold - btc_spy_corr
corr_score      = corr_gap > 0.0 ? math.min(15.0, corr_gap * 50.0) : 0.0

// ── Component 5: Multi-TF alignment (0–15) ───────────────────────────────
rsi_fast        = ta.rsi(close, tf_fast)
sma20           = ta.sma(close, 20)
weekly_old      = close[tf_slow]
weekly_ret      = weekly_old > 0.0 ? (close - weekly_old) / weekly_old : 0.0
tf1             = rsi_fast < 40.0 ? 1.0 : 0.0
tf2             = close < sma20 ? 1.0 : 0.0
tf3             = weekly_ret < 0.0 ? 1.0 : 0.0
tf_total        = 3.0
tf_signal       = tf1 + tf2 + tf3
tf_score        = 15.0 * tf_signal / tf_total

// ── Composite ────────────────────────────────────────────────────────────
composite_score = regime_score + rsi_depth_score + funding_score + corr_score + tf_score

// Signals
long_cond  = composite_score >= composite_threshold and strategy.position_size == 0
exit_cond  = rsi > 70.0

// Entries / Exits
if long_cond
    strategy.entry("Long", strategy.long, comment="Sapphire {{strategy_cls}} Long")

if strategy.position_size > 0
    sl_level = strategy.position_avg_price * (1.0 - sl_pct)
    tp_level = strategy.position_avg_price * (1.0 + tp_pct)
    strategy.exit("Exit", from_entry="Long", stop=sl_level, limit=tp_level)

if exit_cond and strategy.position_size > 0
    strategy.close("Long", comment="RSI overbought")

// Diagnostics
plot(composite_score, "Composite Score", color=color.new(color.aqua, 0))
hline(composite_threshold, "Threshold", color=color.new(color.yellow, 50))
hline(0.0, "Zero", color=color.new(color.gray, 60))
